# Copy this file to server/.env and adjust the production paths.
NODE_ENV=production

# Public HTTPS API on https://your-domain:3000
HOST=0.0.0.0
PORT=3000
USE_HTTPS=true
SSL_KEY=/etc/letsencrypt/live/zcashmetro.io/privkey.pem
SSL_CERT=/etc/letsencrypt/live/zcashmetro.io/fullchain.pem

# Comma-separated values enable automatic lightwalletd failover.
GRPC_SERVER_URL=infra.zcashbr.com:9067
GRPC_PLAINTEXT=false
RPC_DEADLINE_MS=8000

LOG_LEVEL=info
